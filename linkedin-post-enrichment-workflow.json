{
  "name": "LinkedIn Post Enrichment Workflow",
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "id": "1",
      "name": "Start - LinkedIn Post URL",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "notesInFlow": true,
      "notes": "Trigger node - accepts LinkedIn post URL as input"
    },
    {
      "parameters": {
        "url": "=YOUR_API_ENDPOINT/engagement",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParametersJson": "{\n  \"post_url\": \"{{ $node[\\\"Start - LinkedIn Post URL\\\"].json.linkedinPostUrl }}\",\n  \"include_emails\": true\n}",
        "options": {}
      },
      "id": "2",
      "name": "Fetch Post Engagement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ],
      "notesInFlow": true,
      "notes": "Call LinkedIn API to get likers and commenters. Replace with your API endpoint.",
      "credentials": {
        "httpHeaderAuth": "linkedin-api-credentials"
      }
    },
    {
      "parameters": {
        "operation": "map",
        "mapping": {
          "mappingDefinition": {
            "sourceKeys": [
              {
                "key": "profile_id",
                "type": "string"
              },
              {
                "key": "name",
                "type": "string"
              },
              {
                "key": "headline",
                "type": "string"
              },
              {
                "key": "company",
                "type": "string"
              },
              {
                "key": "location",
                "type": "string"
              },
              {
                "key": "email",
                "type": "string"
              }
            ]
          }
        }
      },
      "id": "3",
      "name": "Parse Engagement Data",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        650,
        300
      ],
      "notesInFlow": true,
      "notes": "Extract relevant fields from the engagement data"
    },
    {
      "parameters": {
        "url": "=YOUR_API_ENDPOINT/profile/enrich",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParametersJson": "{\n  \"profile_id\": \"{{ $json.profile_id }}\",\n  \"fields\": [\"name\", \"email\", \"workplace\", \"title\"]\n}",
        "options": {}
      },
      "id": "4",
      "name": "Enrich Profile Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        850,
        300
      ],
      "notesInFlow": true,
      "notes": "Enrich each profile with additional data (name, email, workplace)",
      "credentials": {
        "httpHeaderAuth": "linkedin-api-credentials"
      }
    },
    {
      "parameters": {
        "operation": "filter",
        "node": "Enrich Profile Data",
        "value": "={{ $json.email !== null && $json.email !== '' }}",
        "combineOperation": "AND"
      },
      "id": "5",
      "name": "Filter - Only Profiles with Email",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "notesInFlow": true,
      "notes": "Optional: Filter to keep only profiles with email addresses"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "read",
        "spreadsheetId": "{{ $credentials.spreadsheetId }}",
        "range": "Sheet1!F:F",
        "options": {}
      },
      "id": "5a",
      "name": "Get Existing Profile IDs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1050,
        500
      ],
      "notesInFlow": true,
      "notes": "Read all existing profile_ids from Google Sheets to check for duplicates",
      "credentials": {
        "googleSheetsOAuth2": "google-sheets-credentials"
      }
    },
    {
      "parameters": {
        "mode": "internal",
        "expression": "=const existingIds = $node['Get Existing Profile IDs'].json.map(row => row[0]);\nconst isDuplicate = existingIds.includes($json.profile_id);\nreturn {\n  ...rest: $json,\n  isDuplicate: isDuplicate,\n  shouldSkip: isDuplicate\n};"
      },
      "id": "5b",
      "name": "Deduplicate Profiles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ],
      "notesInFlow": true,
      "notes": "Check if profile_id already exists in Google Sheets. Mark for filtering."
    },
    {
      "parameters": {
        "operation": "filter",
        "node": "Deduplicate Profiles",
        "value": "={{ !$json.shouldSkip }}",
        "combineOperation": "AND"
      },
      "id": "5c",
      "name": "Filter - Remove Duplicates",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "notesInFlow": true,
      "notes": "Filter out duplicate entries that already exist in Google Sheets"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "append",
        "spreadsheetId": "{{ $credentials.spreadsheetId }}",
        "range": "Sheet1!A:G",
        "values": "=[\n  [\"{{ $json.name }}\", \"{{ $json.email }}\", \"{{ $json.workplace }}\", \"{{ $json.headline }}\", \"{{ $json.location }}\", \"{{ $json.profile_id }}\", \"{{ new Date().toISOString() }}\"]\n]"
      },
      "id": "6",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1450,
        300
      ],
      "notesInFlow": true,
      "notes": "Add enriched, deduplicated profile data to Google Sheets",
      "credentials": {
        "googleSheetsOAuth2": "google-sheets-credentials"
      }
    },
    {
      "parameters": {
        "mode": "internal",
        "expression": "=const totalProfiles = $node['Parse Engagement Data'].json?.length || 0;\nconst uniqueProfiles = $node['Filter - Remove Duplicates'].json?.length || 0;\nconst duplicateCount = totalProfiles - uniqueProfiles;\nreturn {\n  status: 'success',\n  message: `Processed ${totalProfiles} profiles. Added ${uniqueProfiles} unique profiles to sheet. Skipped ${duplicateCount} duplicates.`,\n  summary: {\n    total_profiles_found: totalProfiles,\n    unique_profiles_added: uniqueProfiles,\n    duplicates_skipped: duplicateCount,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "7",
      "name": "Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        300
      ],
      "notesInFlow": true,
      "notes": "Return success message with duplicate count"
    },
    {
      "parameters": {
        "message": "=Error processing LinkedIn post: {{ $error.message }}"
      },
      "id": "8",
      "name": "Error Handler",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        850,
        450
      ],
      "notesInFlow": true,
      "notes": "Handle errors from API calls"
    }
  ],
  "connections": {
    "Start - LinkedIn Post URL": {
      "main": [
        [
          {
            "node": "Fetch Post Engagement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Post Engagement": {
      "main": [
        [
          {
            "node": "Parse Engagement Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Engagement Data": {
      "main": [
        [
          {
            "node": "Enrich Profile Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich Profile Data": {
      "main": [
        [
          {
            "node": "Filter - Only Profiles with Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Only Profiles with Email": {
      "main": [
        [
          {
            "node": "Get Existing Profile IDs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Deduplicate Profiles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Existing Profile IDs": {
      "main": [
        [
          {
            "node": "Deduplicate Profiles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deduplicate Profiles": {
      "main": [
        [
          {
            "node": "Filter - Remove Duplicates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Remove Duplicates": {
      "main": [
        [
          {
            "node": "Append to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append to Google Sheets": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "saveManualExecutions": true,
    "errorHandler": {
      "type": "n8n-nodes-base.noOpErrorHandler"
    }
  }
}
